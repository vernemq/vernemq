%% @doc Set the path to a password file.
{mapping, "vmq_passwd.password_file", "vmq_passwd.file",
 [
  {default, "{{platform_etc_dir}}/vmq.passwd"},
  {datatype, file}
 ]}.

%% @doc Set the path to a mountpoint, username and client ID binding file.
{mapping, "vmq_passwd.client_id_file", "vmq_passwd.client_id_file",
 [
  {default, "{{platform_etc_dir}}/vmq.clientids"},
  {datatype, file}
 ]}.

%% @doc Control whether mountpoint, username and client ID bindings are enforced.
{mapping, "vmq_passwd.client_id_binding", "vmq_passwd.client_id_binding",
 [
  {default, disabled},
  {datatype, {enum, [disabled, optional, required]}}
 ]}.

%% @doc set the password reload interval in seconds, the value 0
%% disables the automatic reloading of the password file.
{mapping, "vmq_passwd.password_reload_interval", "vmq_passwd.interval",
 [
  {default, 10},
  {datatype, integer}
 ]}.
